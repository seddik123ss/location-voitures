# Valeurs par défaut de complaint-service (chargées si .env est absent).
# Surcharger en local dans .env.local (non versionné).

APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
DEFAULT_URI=http://localhost:8106

# Base MySQL (compte créé par infra/mysql/init.sql)
DATABASE_URL="mysql://complaint_svc:complaint_pwd@127.0.0.1:3306/complaint_db?serverVersion=8.4&charset=utf8mb4"

# Conventions communes (docs/conventions.md)
SERVICE_PORT=8106
SERVICE_HOST=host.docker.internal
EUREKA_URL=http://localhost:8761/eureka
KEYCLOAK_ISSUER=http://localhost:8180/realms/location-voitures
KEYCLOAK_CLIENT_ID=complaint-service
KEYCLOAK_CLIENT_SECRET=
RABBITMQ_URL=amqp://guest:guest@localhost:5672
