{
  "ConnectionStrings": {
    "ContractDb": "Host=localhost;Port=5432;Database=contract_db;Username=contract_svc;Password=contract_pwd"
  },
  "Fees": {
    "ReturnDeadlineHourUtc": 12,
    "FullTankPrice": 140.000,
    "IncludedKmPerDay": 250,
    "ExtraKmPrice": 0.200
  },
  "RemoteServices": {
    "UseFakes": false,
    "ReservationService": "RENTAL-RESERVATION",
    "PaymentService": "RENTAL-PAYMENT",
    "VehicleService": "RENTAL-VEHICLE",
    "TimeoutSeconds": 5
  },
  "Keycloak": {
    "Issuer": "http://localhost:8180/realms/location-voitures",
    "ClientId": "contract-service",
    "ClientSecret": ""
  },
  "RabbitMq": {
    "Url": "amqp://guest:guest@localhost:5672"
  },
  "spring": {
    "application": {
      "name": "RENTAL-CONTRACT"
    }
  },
  "eureka": {
    "client": {
      "serviceUrl": "http://localhost:8761/eureka/",
      "shouldRegisterWithEureka": true,
      "shouldFetchRegistry": true,
      "registryFetchIntervalSeconds": 10,
      "validateCertificates": false
    },
    "instance": {
      "appName": "RENTAL-CONTRACT",
      "hostName": "host.docker.internal",
      "preferIpAddress": false,
      "port": 8105,
      "healthCheckUrlPath": "/health",
      "statusPageUrlPath": "/swagger/index.html",
      "leaseRenewalIntervalInSeconds": 10
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Steeltoe": "Warning"
    }
  },
  "AllowedHosts": "*"
}
