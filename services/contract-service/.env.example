# Copier ce fichier en .env (non commité) et compléter les valeurs.
# Le service lit ces variables au démarrage (voir docs/conventions.md).
SERVICE_PORT=8105
DB_URL=Host=localhost;Port=5432;Database=contract_db;Username=contract_svc;Password=contract_pwd
EUREKA_URL=http://localhost:8761/eureka
KEYCLOAK_ISSUER=http://localhost:8180/realms/location-voitures
KEYCLOAK_CLIENT_ID=contract-service
# Secret du client contract-service : infra/keycloak/location-voitures-realm.json ou console Keycloak, onglet Credentials
KEYCLOAK_CLIENT_SECRET=
RABBITMQ_URL=amqp://guest:guest@localhost:5672
# Services simulés (données de docs/demo-ids.md) tant qu'ils ne tournent pas :
#   true = tous, false = aucun (appels réels via Eureka),
#   ou une liste : reservation,vehicle = réservation et véhicule simulés, payment appelé pour de vrai
USE_FAKE_SERVICES=false
