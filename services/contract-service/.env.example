# Copier ce fichier en .env (non commité) et compléter les valeurs.
# Le service lit ces variables au démarrage (voir docs/conventions.md).
# Config Server (infra/config-server, port 8888) : lit SERVICE_PORT, SERVICE_HOST, EUREKA_URL et KEYCLOAK_ISSUER
# dans infra/config-repo. Vide = pas d'appel ; injoignable = valeurs par défaut du code.
CONFIG_SERVER_URL=http://localhost:8888
# Fourni par le Config Server (infra/config-repo) ; décommenter pour forcer une valeur locale :
# SERVICE_PORT=8105
DB_URL=Host=localhost;Port=5432;Database=contract_db;Username=contract_svc;Password=contract_pwd
# EUREKA_URL=http://localhost:8761/eureka
# KEYCLOAK_ISSUER=http://localhost:8180/realms/location-voitures
KEYCLOAK_CLIENT_ID=contract-service
# Secret du client contract-service : infra/keycloak/location-voitures-realm.json ou console Keycloak, onglet Credentials
KEYCLOAK_CLIENT_SECRET=
RABBITMQ_URL=amqp://guest:guest@localhost:5672
# Services simulés (données de docs/demo-ids.md) tant qu'ils ne tournent pas :
#   true = tous, false = aucun (appels réels via Eureka),
#   ou une liste : reservation = seule la réservation simulée, payment et vehicle appelés pour de vrai
# Par défaut : false, les trois services (reservation, payment, vehicle) existent et sont appelés via Eureka
USE_FAKE_SERVICES=false
