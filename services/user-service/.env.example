SERVICE_PORT=8101
SERVICE_HOST=host.docker.internal
DB_URL=jdbc:mysql://localhost:3306/user_db
DB_USERNAME=user_svc
DB_PASSWORD=user_pwd
EUREKA_URL=http://localhost:8761/eureka
KEYCLOAK_ISSUER=http://localhost:8180/realms/location-voitures
# Facultatives (Docker : http://keycloak:8080/...). Absentes : déduites de KEYCLOAK_ISSUER.
# KEYCLOAK_JWKS=http://localhost:8180/realms/location-voitures/protocol/openid-connect/certs
# KEYCLOAK_TOKEN_URL=http://localhost:8180/realms/location-voitures/protocol/openid-connect/token
KEYCLOAK_CLIENT_ID=user-service
# Keycloak > Clients > user-service > Credentials (ou champ "secret" du client dans infra/keycloak/location-voitures-realm.json)
KEYCLOAK_CLIENT_SECRET=a_recuperer_dans_keycloak
# true = historique des réservations simulé ; false = appel OpenFeign vers RENTAL-RESERVATION
RESERVATIONS_MOCK=true
