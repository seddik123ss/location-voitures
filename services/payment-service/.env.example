# Copy to .env (never commit .env)
# Config Server (infra/config-server, port 8888) : lit SERVICE_PORT, SERVICE_HOST, EUREKA_URL et KEYCLOAK_ISSUER
# dans infra/config-repo. Vide = pas d'appel ; injoignable = valeurs par défaut du code.
CONFIG_SERVER_URL=http://localhost:8888
# Fourni par le Config Server (infra/config-repo) ; décommenter pour forcer une valeur locale :
# SERVICE_PORT=8104
# Name announced in Eureka (docs/conventions.md). Start the server with: python manage.py runserver 0.0.0.0:8104
# SERVICE_HOST=host.docker.internal
DB_URL=postgres://payment_svc:payment_pwd@localhost:5432/payment_db
# EUREKA_URL=http://localhost:8761/eureka
EUREKA_ENABLED=true
# KEYCLOAK_ISSUER=http://localhost:8180/realms/location-voitures
KEYCLOAK_CLIENT_ID=payment-service
# Secret of the "payment-service" client: Keycloak console > Clients > payment-service > Credentials
KEYCLOAK_CLIENT_SECRET=change-me
RABBITMQ_URL=amqp://guest:guest@localhost:5672/%2F

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*

# Authentication: "jwt" (Keycloak, normal) or "dev" (X-User-Id / X-User-Roles headers, LOCAL ONLY:
# refused when DJANGO_DEBUG=false, the service then does not start)
AUTH_MODE=jwt
# Events: "log" (default: PaymentSucceeded is only written to the log) or "rabbitmq".
# Keep "log" until reservation-service has declared its queue reservation.payment_succeeded
# (otherwise every successful payment gets 503); switch to "rabbitmq" on integration day.
EVENT_PUBLISHER=log
LOG_LEVEL=INFO

# Reservation client: "fake" (simulated, until reservation-service is ready) or "http" (Eureka + service token)
RESERVATION_CLIENT=fake
