# Copy to .env (never commit .env)
SERVICE_PORT=8104
DB_URL=postgres://payment_svc:payment_pwd@localhost:5432/payment_db
EUREKA_URL=http://localhost:8761/eureka
KEYCLOAK_ISSUER=http://localhost:8180/realms/location-voitures
KEYCLOAK_CLIENT_ID=payment-service
KEYCLOAK_CLIENT_SECRET=change-me
RABBITMQ_URL=amqp://guest:guest@localhost:5672/%2F

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*

# Authentication: "dev" (X-User-Id / X-User-Roles headers, LOCAL ONLY) or "jwt" (Keycloak, step 3)
AUTH_MODE=dev
# Events: "log" (only logged) or "rabbitmq" (step 3)
EVENT_PUBLISHER=log
LOG_LEVEL=INFO

# Reservation client: "fake" (simulated, until reservation-service is ready) or "http" (Eureka)
RESERVATION_CLIENT=fake
