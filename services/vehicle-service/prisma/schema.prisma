generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DB_URL")
  shadowDatabaseUrl = env("SHADOW_DB_URL")
}

enum VehicleStatus {
  AVAILABLE
  RENTED
  MAINTENANCE
  OUT_OF_SERVICE
}

enum Fuel {
  GASOLINE
  DIESEL
  HYBRID
  ELECTRIC
}

enum Transmission {
  MANUAL
  AUTOMATIC
}

model Category {
  id        String    @id @default(uuid()) @db.Char(36)
  name      String    @unique @db.VarChar(100)
  dailyRate Decimal   @db.Decimal(10, 3)
  deposit   Decimal   @db.Decimal(10, 3)
  vehicles  Vehicle[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("categories")
}

model Agency {
  id        String    @id @default(uuid()) @db.Char(36)
  name      String    @db.VarChar(100)
  city      String    @db.VarChar(100)
  address   String    @db.VarChar(255)
  vehicles  Vehicle[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("agencies")
}

model Vehicle {
  id           String        @id @default(uuid()) @db.Char(36)
  plate        String        @unique @db.VarChar(20)
  brand        String        @db.VarChar(50)
  model        String        @db.VarChar(50)
  year         Int
  fuel         Fuel
  transmission Transmission
  seats        Int
  mileage      Int
  status       VehicleStatus @default(AVAILABLE)
  categoryId   String        @db.Char(36)
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  agencyId     String        @db.Char(36)
  agency       Agency        @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  maintenances Maintenance[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status])
  @@map("vehicles")
}

model Maintenance {
  id        String   @id @default(uuid()) @db.Char(36)
  vehicleId String   @db.Char(36)
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type      String   @db.VarChar(100)
  date      DateTime @db.Date
  cost      Decimal  @db.Decimal(10, 3)
  createdAt DateTime @default(now())

  @@map("maintenances")
}

model ProcessedEvent {
  eventId     String   @id @db.Char(36)
  type        String   @db.VarChar(50)
  processedAt DateTime @default(now())

  @@map("processed_events")
}