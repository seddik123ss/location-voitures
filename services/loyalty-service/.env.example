# Copier en .env (jamais commité). Lu par Spring (spring.config.import) au démarrage avec mvnw spring-boot:run.
SERVICE_PORT=8108
SERVICE_HOST=host.docker.internal
DB_URL=jdbc:mysql://localhost:3306/loyalty_db
DB_USERNAME=loyalty_svc
DB_PASSWORD=loyalty_pwd
EUREKA_URL=http://localhost:8761/eureka
KEYCLOAK_ISSUER=http://localhost:8180/realms/location-voitures
# Facultatives (Docker : http://keycloak:8080/...). Absentes : déduites de KEYCLOAK_ISSUER.
# KEYCLOAK_JWKS=http://localhost:8180/realms/location-voitures/protocol/openid-connect/certs
# KEYCLOAK_TOKEN_URL=http://localhost:8180/realms/location-voitures/protocol/openid-connect/token
KEYCLOAK_CLIENT_ID=loyalty-service
# Keycloak > Clients > loyalty-service > Credentials (ou champ "secret" du client dans infra/keycloak/location-voitures-realm.json)
KEYCLOAK_CLIENT_SECRET=
RABBITMQ_URL=amqp://guest:guest@localhost:5672
