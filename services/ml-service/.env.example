# Copier ce fichier en .env (Copy-Item .env.example .env) puis compléter.
# Le fichier .env n'est jamais commité.

# Port d'écoute du service (convention de l'équipe : 8107 pour ml-service)
SERVICE_PORT=8107
# Nom annoncé dans Eureka (voir docs/conventions.md)
SERVICE_HOST=host.docker.internal

# PostgreSQL : base ml_db, utilisateur ml_svc (infra/postgres/init.sql)
DB_URL=postgresql+psycopg://ml_svc:ml_pwd@localhost:5432/ml_db

# Intégrations (Eureka, Keycloak, RabbitMQ)
EUREKA_URL=http://localhost:8761/eureka
# false pour démarrer sans s'inscrire dans Eureka (les tests le mettent à false)
EUREKA_ENABLED=true
# Émetteur attendu dans les tokens (claim iss)
KEYCLOAK_ISSUER=http://localhost:8180/realms/location-voitures
# Optionnel : adresse des clés publiques (par défaut <KEYCLOAK_ISSUER>/protocol/openid-connect/certs)
KEYCLOAK_JWKS_URL=
KEYCLOAK_CLIENT_ID=ml-service
# Secret du client ml-service (pour DEMANDER un token de service, pas pour vérifier) :
# infra/keycloak/location-voitures-realm.json ou console Keycloak > Clients > ml-service > Credentials
KEYCLOAK_CLIENT_SECRET=a-completer
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
