# reservation-service : copier en .env (non versionné), puis php artisan key:generate
APP_NAME=reservation-service
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8103

# Conventions communes (docs/conventions.md)
SERVICE_PORT=8103
SERVICE_HOST=host.docker.internal

# Base MySQL (compte de développement créé par infra/mysql/init.sql)
DB_CONNECTION=mysql
DB_URL=mysql://reservation_svc:reservation_pwd@127.0.0.1:3306/reservation_db

# Eureka (étape 3)
EUREKA_URL=http://localhost:8761/eureka

# Keycloak (étape 2). Le secret du client reservation-service est dans
# infra/keycloak/location-voitures-realm.json : le mettre seulement dans .env, jamais ici.
KEYCLOAK_ISSUER=http://localhost:8180/realms/location-voitures
KEYCLOAK_JWKS=
KEYCLOAK_TOKEN_URL=
KEYCLOAK_CLIENT_ID=reservation-service
KEYCLOAK_CLIENT_SECRET=

# RabbitMQ (étape 5)
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Appels à user-service et vehicle-service (étape 4) : demo (sans appel) ou eureka
LOOKUP_MODE=demo

# Service API : pas de session, cache sur disque, pas de file Laravel
SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Swagger UI (http://localhost:8103/api/doc) : régénère le contrat à chaque affichage en développement
L5_SWAGGER_GENERATE_ALWAYS=true
