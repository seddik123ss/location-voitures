* text=auto eol=lf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore

# Script exécuté par /bin/sh dans le conteneur : toujours en LF, même après un checkout sous Windows.
*.sh text eol=lf
